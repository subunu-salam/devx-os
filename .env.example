# Copy to .env for local overrides (optional — sensible defaults are built in).
PORT=3000
NODE_ENV=development
# Secret used to sign login sessions. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database + uploaded receipts are stored.
# Locally this defaults to ./data. On Render, point it at a persistent disk (e.g. /var/data).
# DATA_DIR=/var/data
